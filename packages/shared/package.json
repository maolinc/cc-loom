{
  "name": "@maolinc/cc-loom-shared",
  "version": "0.1.2",
  "description": "Loom shared types, validators, and constants — single source of truth for server & CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maolinc/cc-loom.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/maolinc/cc-loom#readme",
  "bugs": {
    "url": "https://github.com/maolinc/cc-loom/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepack": "pnpm run build",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
