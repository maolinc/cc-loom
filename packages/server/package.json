{
  "name": "@maolinc/cc-loom-server",
  "version": "0.1.5",
  "description": "Loom server — Fastify backend with SQLite, WebSocket, and static SPA serving",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maolinc/cc-loom.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/maolinc/cc-loom#readme",
  "bugs": {
    "url": "https://github.com/maolinc/cc-loom/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "loom-server": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"require('node:fs').cpSync('../web/dist','dist/web-dist',{recursive:true})\"",
    "prepack": "pnpm --dir ../web run build && pnpm run build",
    "dev": "node --watch --import tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/compress": "^9.1.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "@maolinc/cc-loom-adapter": "workspace:*",
    "@maolinc/cc-loom-shared": "workspace:*",
    "better-sqlite3": "12.6.2",
    "fastify": "^5.10.0",
    "fflate": "^0.8.2",
    "p-retry": "^6.2.0",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@maolinc/cc-loom-web": "workspace:*",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.19.0",
    "@types/ws": "^8.5.12",
    "@vitest/ui": "^1.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0",
    "ws": "^8.21.1"
  }
}
