# Loom 测试基础镜像 — Node 22 + 编译工具链 + git + Playwright 依赖
# 用 Debian slim（非 Alpine），因为 Playwright chromium 需要 glibc
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ git bash ca-certificates \
    # Playwright chromium 运行时依赖
    libnss3 libfreetype6 libharfbuzz0b libfontconfig1 libxcomposite1 \
    libxrandr2 libgbm1 libxkbcommon0 libpango-1.0-0 libcairo2 libasound2 \
    libatk-bridge2.0-0 libatk1.0-0 libcups2 libdrm2 libxshmfence1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
